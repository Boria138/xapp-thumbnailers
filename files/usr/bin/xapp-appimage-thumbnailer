#!/usr/bin/python3

import glob
import os
import shutil
import subprocess
import sys
import tempfile
from elftools.elf.elffile import ELFFile

import gi
gi.require_version("XApp", "1.0")
from gi.repository import XApp

import XappThumbnailers
t = XappThumbnailers.Thumbnailer()

# Find the section header offset within the ELF file
with open(t.args.input, 'rb') as f:
    elf = ELFFile(f)
    app_image_offset = elf['e_shoff'] + (elf['e_shentsize'] * elf['e_shnum'])
    f.seek(app_image_offset)
    payload_magic = f.read(6)

def lookup_icon(filename):
    return subprocess.check_output([
            'unsquashfs',
            '-o', str(app_image_offset),
            '-ll',
            t.args.input,
            filename
        ]).decode()

def extract_icon(outdir, filename):
    if payload_magic == b'DWARFS':
        os.makedirs(outdir, exist_ok=True)
        cmd = [
            'dwarfsextract',
            '-i', t.args.input,
            '-O', str(app_image_offset),
            '-o', outdir,
            '--pattern', ':' + glob.escape(filename),
            '--skip-devices',
            '--skip-specials',
            '--log-level', 'error',
        ]
    else:
        cmd = [
            'unsquashfs',
            '-o', str(app_image_offset),
            '-d', outdir,
            t.args.input,
            filename,
        ]

    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def save_dwarfs_icon():
    if not shutil.which('dwarfsextract'):
        print("xapp-appimage-thumbnailer: dwarfsextract is required", file=sys.stderr)
        return False

    with tempfile.TemporaryDirectory(dir=XApp.get_tmp_dir()) as outdir:
        filename = '.DirIcon'
        seen = set()
        while filename not in seen:
            seen.add(filename)
            try:
                extract_icon(outdir, filename)
            except subprocess.CalledProcessError:
                return False
            path = os.path.join(outdir, filename)
            if not os.path.islink(path):
                return os.path.isfile(path) and t.save_path(path)
            target = os.readlink(path)
            filename = os.path.normpath(os.path.join(os.path.dirname(filename), target)
                                        if not target.startswith('/') else target.lstrip('/'))
            if filename == '..' or filename.startswith('../'):
                return False
    return False

if payload_magic == b'DWARFS':
    sys.exit(0 if save_dwarfs_icon() else 1)

# Find the location of the icon inside the AppImage payload
icon_path = '.DirIcon'
while True:
    output = lookup_icon(icon_path)

    if not output:
        # File not found, fail
        sys.exit(1)

    if ' -> ' not in output:
        # icon path is not a symlink, let's use it
        break

    icon_path = output.strip().split(' -> ')[1]
    # Some appimages use local apppimage paths, e.g., ./usr/applications/...
    if icon_path[0:2] == './':
        icon_path = icon_path[2:]

# Extract the icon
with tempfile.TemporaryDirectory(dir=XApp.get_tmp_dir()) as tmpdir:
    outdir = os.path.join(tmpdir, 'out')
    extract_icon(outdir, icon_path)
    icon_path = os.path.join(outdir, icon_path)
    success = t.save_path(icon_path)
sys.exit(0 if success else 1)
